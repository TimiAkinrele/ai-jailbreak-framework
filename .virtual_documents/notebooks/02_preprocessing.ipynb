def clean_text(text: str) -> str:
    if not isinstance(text, str):
        return ""

    text = unicodedata.normalize("NFKC", text)
    text = text.strip()
    text = " ".join(text.split())
    return text


df_adv = pd.DataFrame({
    "prompt_Text": df_adv_harm["goal"].astype(str).apply(clean_text),
    "label": 1,
